# Local default is sqlite:///teoria.db next to the app (not committed).
# Production (Ubuntu + Cloudflare Tunnel): copy to /opt/teoria/.env
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql://teoria:change-me@127.0.0.1:5432/teoria
TEORIA_PORT=8012
TEORIA_SECURE_COOKIES=1
PREFERRED_URL_SCHEME=https
# Comma-separated login emails that can open /admin
TEORIA_ADMINS=you@example.com
# AI for “ახსენი AI-ით” on truly-unknown tickets.
# Prefer Gemini for Georgian quality: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Optional fast fallback: https://console.groq.com
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# Force provider when both keys are set: gemini | groq
# AI_PROVIDER=gemini
FLASK_ENV=production
FLASK_DEBUG=0
# PORT=5000
