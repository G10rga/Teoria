# Local default is sqlite:///teoria.db next to the app (not committed).
# Production (Ubuntu + Cloudflare Tunnel): copy to /opt/teoria/.env
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql://teoria:change-me@127.0.0.1:5432/teoria
TEORIA_PORT=8012
TEORIA_SECURE_COOKIES=1
PREFERRED_URL_SCHEME=https
# Comma-separated login emails that can open /admin
TEORIA_ADMINS=you@example.com
FLASK_ENV=production
FLASK_DEBUG=0
# PORT=5000
